#!/bin/sh
# COMB Nano — staged memory (JSON lines, tmpfs-backed)
DIR="${OSYM_COMB_DIR:-/data/comb/staging}"
mkdir -p "$DIR" 2>/dev/null
TODAY="$(date +%Y-%m-%d 2>/dev/null || echo unknown)"
esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr '\n\r' '  '; }
case "${1:-}" in
    stage)
        shift
        printf '{"ts":"%s","text":"%s"}\n' "$(date -Iseconds 2>/dev/null || date)" "$(esc "$*")" >> "$DIR/$TODAY.jsonl"
        ;;
    recall) case "${2:-20}" in ''|*[!0-9]*) N=20 ;; *) N="${2:-20}" ;; esac; cat "$DIR"/*.jsonl 2>/dev/null | tail -n "$N" ;;
    stats) echo "{\"entries\":$(cat "$DIR"/*.jsonl 2>/dev/null | wc -l | tr -d ' '),\"files\":$(ls "$DIR"/*.jsonl 2>/dev/null | wc -l | tr -d ' ')}" ;;
    clear) rm -f "$DIR"/*.jsonl ;;
    *) echo "Usage: comb {stage TEXT|recall [N]|stats|clear}" ;;
esac
