#!/bin/sh
# symbiote-init — OSymbiote PID 1: boots, starts the HTTP agent, then opens the shell.

export PATH=/bin:/sbin:/usr/bin
export HOME=/root TERM="${TERM:-linux}"

mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || {
    mknod /dev/console c 5 1 2>/dev/null
    mknod /dev/null c 1 3 2>/dev/null
    mknod /dev/ttyS0 c 4 64 2>/dev/null
    mknod /dev/zero c 1 5 2>/dev/null
    mknod /dev/urandom c 1 9 2>/dev/null
}
mount -t tmpfs none /tmp
mount -t tmpfs none /run
mkdir -p /dev/pts /dev/shm /root
mount -t devpts devpts /dev/pts 2>/dev/null || true
mount -t tmpfs tmpfs /dev/shm 2>/dev/null || true

mkdir -p /data
OSYM_DATA_PERSISTENT=0
for m in virtio_ring virtio virtio_pci_modern_dev virtio_pci_legacy_dev virtio_pci netfs 9pnet 9pnet_virtio 9p; do
    for f in /lib/modules/$m.ko /lib/modules/$m.ko.gz; do
        [ -f "$f" ] && { /bin/busybox insmod "$f" 2>/dev/null; break; }
    done
done
if mount -t 9p -o trans=virtio,version=9p2000.L osymdata /data 2>/dev/null; then
    OSYM_DATA_PERSISTENT=1
    echo "[init] Persistent data: mounted QEMU shared storage at /data"
else
    echo "[init] WARNING: persistent data unavailable; settings will be lost at shutdown"
fi
export OSYM_DATA_PERSISTENT

# Make sure every busybox applet is registered as a command.
/bin/busybox --install -s /bin 2>/dev/null || true

clear 2>/dev/null || true
echo ""
echo "  ○ S Y M B I O T E  —  booting"
echo ""

CORES=$(grep -c ^processor /proc/cpuinfo 2>/dev/null || echo 1)
MEM_KB=$(awk '/MemTotal/{print $2}' /proc/meminfo 2>/dev/null || echo 0)
MEM_MB=$((MEM_KB / 1024))
ARCH=$(uname -m 2>/dev/null || echo "unknown")
HOSTNAME="osymbiote"
hostname "$HOSTNAME" 2>/dev/null || true
echo "[init] Hardware: ${CORES} cores, ${MEM_MB}MB RAM, ${ARCH}"

echo "[init] Network..."
# NIC drivers ship as modules; dependency order matters.
for m in af_packet failover net_failover virtio_ring virtio_pci_modern_dev virtio_pci_legacy_dev virtio_pci virtio_net e1000; do
    for f in /lib/modules/$m.ko /lib/modules/$m.ko.gz; do
        [ -f "$f" ] && { insmod "$f" 2>/dev/null; break; }
    done
done
sleep 1
ip link set lo up 2>/dev/null
for iface_path in /sys/class/net/*; do
    iface=${iface_path##*/}
    [ "$iface" = lo ] && continue
    [ -e "/sys/class/net/$iface" ] || continue
    ip link set "$iface" up 2>/dev/null
    # wait for link (up to ~10s), then DHCP with retries
    n=0
    while [ "$n" -lt 10 ] && [ "$(cat "/sys/class/net/$iface/carrier" 2>/dev/null)" != "1" ]; do sleep 1; n=$((n + 1)); done
    t=0
    while [ "$t" -lt 4 ]; do
        udhcpc -i "$iface" -s /etc/udhcpc.sh -q -n >/dev/null 2>&1
        IP_ADDR=$(ip -4 addr show "$iface" 2>/dev/null | awk '/inet /{print $2}' | cut -d/ -f1)
        if [ -n "$IP_ADDR" ]; then
            echo "[init] Network: $iface → $IP_ADDR"
            break 2
        fi
        t=$((t + 1)); sleep 1
    done
done

echo "[init] COMB Nano: ready"
mkdir -p /data/comb/staging /data/osymbiote
if [ ! -f /data/osymbiote/.env ] && [ -f /etc/osymbiote/.env.example ]; then
    cp /etc/osymbiote/.env.example /data/osymbiote/.env
fi
if [ -f /data/osymbiote/.env ]; then chmod 600 /data/osymbiote/.env; fi
if [ ! -f /data/osymbiote/system.conf ] && [ -f /etc/osymbiote/system.conf.example ]; then
    cp /etc/osymbiote/system.conf.example /data/osymbiote/system.conf
fi
if [ -f /data/osymbiote/system.conf ]; then chmod 600 /data/osymbiote/system.conf; fi
if [ -f /data/osymbiote/config ]; then chmod 600 /data/osymbiote/config; fi
/bin/comb stage "OSymbiote booted. ${CORES} cores, ${MEM_MB}MB RAM, ${ARCH}" 2>/dev/null || true

cat > /run/hardware.json << HWEOF
{
  "hostname": "$HOSTNAME",
  "arch": "$ARCH",
  "cores": $CORES,
  "ram_mb": $MEM_MB,
  "display": false,
  "gpu": null,
  "network": "$(ip -4 addr show 2>/dev/null | awk '/inet /{print $2}' | grep -v '127\.' | head -1 | cut -d/ -f1)",
  "boot_time": "$(date -Iseconds 2>/dev/null || date)"
}
HWEOF

AGENT_PORT=8422
HANDLER=/usr/lib/osym/agent_handler.sh

serve_agent() {
    # busybox "nc -lk" forks a handler per connection (browsers open several at once);
    # fall back to tcpsvd, then to serial single-shot "nc -l -e".
    if /bin/busybox --list 2>/dev/null | grep -qx tcpsvd; then
        tcpsvd -E 0.0.0.0 "$AGENT_PORT" "$HANDLER" 2>/dev/null
    elif nc --help 2>&1 | grep -q -- '-lk'; then
        nc -lk -p "$AGENT_PORT" -e "$HANDLER" 2>/dev/null
    else
        nc -l -p "$AGENT_PORT" -e "$HANDLER" 2>/dev/null
        return
    fi
    sleep 1
}

echo "[init] Starting agent on :$AGENT_PORT"
(while true; do serve_agent; done) &

/bin/comb stage "Boot complete. Agent on :$AGENT_PORT" 2>/dev/null || true
echo "[init] Agent: http://localhost:8422 (host port forwarded by QEMU)"
echo "[init] Opening shell. Ctrl+A X exits QEMU."
sleep 1

# PID 1 keeps the console shell alive.
while true; do
    if /bin/busybox --list 2>/dev/null | grep -qx cttyhack; then
        setsid cttyhack /bin/osh
    else
        /bin/osh
    fi
    echo "[init] shell exited — respawning"
    sleep 1
done
